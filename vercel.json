{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "bun install",
  "buildCommand": "bun run vercel-build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?__path=$1"
    },
    {
      "source": "/",
      "destination": "/api?__path="
    }
  ]
}
