{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "bun install",
  "buildCommand": "bun run vercel-build",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api?__path=$1"
    },
    {
      "src": "/",
      "dest": "/api?__path="
    }
  ]
}
