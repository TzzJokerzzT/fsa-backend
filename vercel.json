{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "bun install",
  "buildCommand": "mkdir -p public && echo 'ok' > public/.placeholder",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/health"
    }
  ]
}
