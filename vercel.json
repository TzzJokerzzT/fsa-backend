{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npx esbuild src/vercel-entry.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
