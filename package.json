{
  "name": "fsa-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "start": "bun run dist/main.js",
    "test": "bun test",
    "lint": "biome check src",
    "format": "biome format --write src"
  },
  "dependencies": {
    "argon2": "^0.41.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "hono": "^4.6.0",
    "http-status-codes": "^2.3.0",
    "jose": "^5.9.0",
    "mongoose": "^9.7.0",
    "valibot": "^0.42.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
